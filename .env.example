# Copiez ce fichier en .env et remplissez les valeurs.
# Ne commitez jamais le fichier .env (reste local).

# Mot de passe pour accéder à l'admin (obligatoire en production)
ADMIN_PASSWORD=votre_mot_de_passe_secret

# Secret pour les sessions (générer une chaîne aléatoire en production)
SESSION_SECRET=changez-moi-une-chaine-aleatoire-longue

# Port du serveur (optionnel, défaut 3000)
PORT=3000
